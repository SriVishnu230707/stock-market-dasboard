# Copy this file to .env and fill in real values.

# Local MongoDB:   mongodb://127.0.0.1:27017/stockdash
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockdash
MONGO_URI=mongodb://127.0.0.1:27017/stockdash

JWT_SECRET=change-this-to-a-long-random-string

PORT=4000

# Comma-separated list of origins allowed to call the API / open sockets.
CLIENT_ORIGIN=http://localhost:5173
