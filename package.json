{
  "name": "ticker-room",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time MERN stock dashboard (server + client)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.9.0",
    "prettier": "^3.3.3"
  }
}
